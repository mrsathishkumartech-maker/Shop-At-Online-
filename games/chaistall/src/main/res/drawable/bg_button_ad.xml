<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#1F6B30" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape><solid android:color="@color/button_disabled" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/ad" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
